{
  "name": "meesho-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:admin": "concurrently -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"vite --host --mode admin\" \"npm run dev:server\"",
    "dev:client": "vite --host",
    "dev:server": "nodemon backend/index.js",
    "start": "node backend/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "node backend/database/initDb.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "mysql2": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.5"
  }
}
